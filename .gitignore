# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Data - never commit datasets, images, or embeddings
data/
images/
*.parquet
*.zst
*.json.gz
*.npy
*.npz

# Outputs
runs/
models/
*.log

# Frozen split artifacts live in splits/ (not data/) precisely so they escape
# the data/ rule above and can be committed. Keep them there.
